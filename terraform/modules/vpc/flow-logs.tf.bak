#############################################
# VPC Flow Logs
#############################################

resource "aws_flow_log" "this" {

  traffic_type = "ALL"

  vpc_id = aws_vpc.this.id

  log_destination_type = "cloud-watch-logs"

  iam_role_arn = var.flow_logs_iam_role_arn

  log_group_name = var.flow_logs_log_group_name

  tags = merge(
    local.common_tags,
    {
      Name = "${local.name_prefix}-flow-logs"
    }
  )
}